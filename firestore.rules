rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 30 &&
             data.bestScore is int &&
             data.bestScore >= 0 &&
             data.bestScore <= 10000000 &&
             data.maxDistanceMeters is int &&
             data.maxDistanceMeters >= 0 &&
             data.maxDistanceMeters <= 1000000 &&
             data.bestCombo is int &&
             data.bestCombo >= 0 &&
             data.bestCombo <= 10000 &&
             data.gamesPlayed is int &&
             data.gamesPlayed >= 1 &&
             data.gamesPlayed <= 1000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPlayerProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 30 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             data.musicEnabled is bool &&
             data.sfxEnabled is bool &&
             data.totalOrbsCollected is int &&
             data.totalOrbsCollected >= 0 &&
             data.totalOrbsCollected <= 10000000 &&
             data.totalRuns is int &&
             data.totalRuns >= 0 &&
             data.totalRuns <= 1000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidGameRun(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.score is int &&
             data.score >= 0 &&
             data.score <= 10000000 &&
             data.distanceMeters is int &&
             data.distanceMeters >= 0 &&
             data.distanceMeters <= 1000000 &&
             data.orbsCollected is int &&
             data.orbsCollected >= 0 &&
             data.orbsCollected <= 100000 &&
             data.shieldsUsed is int &&
             data.shieldsUsed >= 0 &&
             data.shieldsUsed <= 1000 &&
             data.boostsUsed is int &&
             data.boostsUsed >= 0 &&
             data.boostsUsed <= 1000 &&
             data.peakIntensity is int &&
             data.peakIntensity >= 1 &&
             data.peakIntensity <= 4 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    // Global Leaderboard (public non-PII game stats readable by signed-in players; owner-only writes)
    match /leaderboard/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'bestScore', 'maxDistanceMeters', 'bestCombo', 'gamesPlayed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'bestScore', 'maxDistanceMeters', 'bestCombo', 'gamesPlayed', 'createdAt', 'updatedAt']) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidLeaderboardEntry(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().bestScore >= existing().bestScore &&
                       incoming().maxDistanceMeters >= existing().maxDistanceMeters &&
                       incoming().bestCombo >= existing().bestCombo &&
                       incoming().gamesPlayed >= existing().gamesPlayed &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bestScore', 'maxDistanceMeters', 'bestCombo', 'gamesPlayed', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Owner-isolated private player profile & audio preferences
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'musicEnabled', 'sfxEnabled', 'totalOrbsCollected', 'totalRuns', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'musicEnabled', 'sfxEnabled', 'totalOrbsCollected', 'totalRuns', 'createdAt', 'updatedAt']) &&
                       isValidPlayerProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidPlayerProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'musicEnabled', 'sfxEnabled', 'totalOrbsCollected', 'totalRuns', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // Owner-isolated personal run history
      match /runs/{runId} {
        allow get: if isSignedIn() && isValidId(runId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(runId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'score', 'distanceMeters', 'orbsCollected', 'shieldsUsed', 'boostsUsed', 'peakIntensity', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'score', 'distanceMeters', 'orbsCollected', 'shieldsUsed', 'boostsUsed', 'peakIntensity', 'createdAt']) &&
                         isValidGameRun(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(runId) && request.auth.uid == userId;
      }
    }
  }
}
